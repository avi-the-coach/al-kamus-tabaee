[
  {
    "id": "p-001",
    "transcription": "אִגִ׳ית עַלְוַקְת",
    "literal": "באתי על הזמן",
    "meaning": "הגעתי בזמן"
  },
  {
    "id": "p-002",
    "transcription": "אַלָּה יַעְטִיכּ אִלְעַאפְיֶה עַ טּוּל",
    "literal": "אלוהים ייתן לך בריאות על האורך",
    "meaning": "שתהיה בריא תמיד"
  },
  {
    "id": "p-003",
    "transcription": "אִנְתַ עַ בַּאלִי טוּל אִלְיוֹם",
    "literal": "אתה על המחשבה שלי אורך היום",
    "meaning": "אני חושב עליך כל היום"
  },
  {
    "id": "p-004",
    "transcription": "וִקֶע מִן בַּאלִי אַרֻדּ עַלֵיכּ",
    "literal": "נפל מהמחשבה שלי לענות עליך",
    "meaning": "שכחתי לענות לך"
  },
  {
    "id": "p-005",
    "transcription": "נַפְסִי בְּפִנְגַ׳אן קַהְוֶה",
    "literal": "הנפש שלי בכוס קפה",
    "meaning": "מתחשק לי קפה"
  },
  {
    "id": "p-006",
    "transcription": "מַעִי מַצַארִי",
