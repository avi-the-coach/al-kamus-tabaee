  },
  {
    "id": "p-028",
    "transcription": "מִש עַ קַדּ אִלְמַסְאוּלִיֶּה",
    "literal": "לא על הגודל של האחריות",
    "meaning": "לא מסוגל לעמוד באחריות"
  },
  {
    "id": "p-029",
    "transcription": "כֻּנְת עַ וַשַכּ אַטְלַע",
