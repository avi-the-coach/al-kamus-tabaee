  },
  {
    "id": "p-043",
    "transcription": "חֻ׳ד אִלְקַרַאר עַלַא מַהְלַכּ",
    "literal": "קח את ההחלטה על הנחת שלך",
    "meaning": "קבל את ההחלטה בלי למהר"
  },
  {
    "id": "p-044",
    "transcription": "כֻּלּ אִשִי בִּיגִ׳י עַלַא מַהְלוֹ",
    "literal": "כל דבר בא על הנחת שלו",
    "meaning": "לכל דבר יש הקצב והזמן שלו"
  },
  {
    "id": "p-045",
    "transcription": "בִּדִּי מֻהְלֶה שְוַיּ עַשַאן אַפַכֶּר",
