  },
  {
    "id": "p-046",
    "transcription": "עַטִינִי מֻהְלֶה לַבֻּכְּרַא",
    "literal": "תן לי שהות למחר",
    "meaning": "תן לי ארכה עד מחר"
  },
  {
    "id": "p-047",
    "transcription": "עַלַא מַהְלַכּ עַלַיּ, לִסַּא בַּתְעַלַּם",
